<UserControl x:Class="CommunicationManager.UI.CommunicationManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="500">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <Expander Header="Communication Manager" IsExpanded="{Binding IsManagerExpanded, Mode=TwoWay}">
              <StackPanel Margin="4,8,4,4">
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Padding="10,5" Content="Add serial connection"
                        Command="{Binding AddChannelCommand}" />
                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                           Text="Serial connections" />
            </DockPanel>
            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"
                       Text="Each connection has its own port and property mappings. Incoming !external-name:value messages update the mapped property; Send updates transmits changes using the same format. Struct properties and typed arrays are exchanged as schema-validated JSON. Map a struct to send it when a matching member property changes; use qualified names such as Device.Temperature when a member name is ambiguous." />

            <ItemsControl ItemsSource="{Binding Channels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12" Padding="10" BorderBrush="#808080"
                                BorderThickness="1" CornerRadius="3">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Padding="8,4" Content="Remove connection"
                                            Command="{Binding DataContext.RemoveChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                               Text="Serial connection" />
                                </DockPanel>
                                <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
                                    <StackPanel Width="180" Margin="0,0,12,8">
                                        <TextBlock Margin="0,0,0,4" Text="Serial port" />
                                        <ComboBox IsEditable="True" ItemsSource="{Binding PortNames}"
                                                  Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanConfigure}" />
                                    </StackPanel>
                                    <StackPanel Width="120" Margin="0,0,12,8">
                                        <TextBlock Margin="0,0,0,4" Text="Baud rate" />
                                        <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding BaudRate}"
                                                  IsEnabled="{Binding CanConfigure}" />
                                    </StackPanel>
                                    <Button Margin="0,18,8,8" Padding="10,5" Content="Refresh ports"
                                            Command="{Binding RefreshPortsCommand}" IsEnabled="{Binding CanConfigure}" />
                                    <Button Margin="0,18,8,8" Padding="10,5" Content="Connect"
                                            Command="{Binding StartCommand}" IsEnabled="{Binding CanConfigure}" />
                                    <Button Margin="0,18,0,8" Padding="10,5" Content="Disconnect"
                                            Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" />
                                </WrapPanel>

                                <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Properties for this connection" />
                                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                    <Button Padding="10,5" Content="Add mapping" Command="{Binding AddMappingCommand}"
                                            IsEnabled="{Binding CanConfigure}" />
                                    <Button Margin="8,0,0,0" Padding="10,5" Content="Refresh properties"
                                            Command="{Binding RefreshPropertiesCommand}" IsEnabled="{Binding CanConfigure}" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding Mappings}" IsEnabled="{Binding CanConfigure}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          MinHeight="80" MaxHeight="240" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Property" Width="2*" MinWidth="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox IsEditable="True" ItemsSource="{Binding DataContext.PropertyNames, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              Text="{Binding PropertyName, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="External name" Width="2*" MinWidth="120"
                                                            Binding="{Binding ExternalName, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTemplateColumn Header="Send updates" Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              IsChecked="{Binding SendUpdates, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="" Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Padding="8,3" Content="Remove"
                                                            Command="{Binding DataContext.RemoveMappingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Margin="0,4,0,4" FontWeight="SemiBold" Text="Send direct message" />
                                <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"
                                           Text="Send one line exactly as entered; line breaks are not allowed. Use Up/Down to recall sent messages." />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                             Text="{Binding DirectMessage, UpdateSourceTrigger=PropertyChanged}"
                                             PreviewKeyDown="DirectMessageTextBox_PreviewKeyDown"
                                             IsEnabled="{Binding IsRunning}" />
                                    <Button Grid.Column="1" Padding="10,5" Content="Send"
                                            Command="{Binding SendDirectMessageCommand}" />
                                </Grid>
                                <TextBlock Margin="0,6,0,0" Foreground="Firebrick" TextWrapping="Wrap"
                                           Text="{Binding Status}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
              </StackPanel>
            </Expander>

            <Expander Margin="0,8,0,0" Header="Communication log" IsExpanded="{Binding IsLogExpanded, Mode=TwoWay}">
            <ListView x:Name="MessageListView" Margin="4,8,4,4" Height="220" ItemsSource="{Binding Messages}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="105" Header="Time"
                                        DisplayMemberBinding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}" />
                        <GridViewColumn Width="90" Header="Port" DisplayMemberBinding="{Binding PortName}" />
                        <GridViewColumn Width="80" Header="Direction" DisplayMemberBinding="{Binding Direction}" />
                        <GridViewColumn Width="500" Header="Message" DisplayMemberBinding="{Binding Message}" />
                    </GridView>
                </ListView.View>
            </ListView>
            </Expander>

            <TextBlock Margin="0,8,0,0" Foreground="Firebrick" TextWrapping="Wrap"
                       Text="{Binding Status}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

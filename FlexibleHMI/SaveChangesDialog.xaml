<Window x:Class="FlexibleHMI.SaveChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unsaved changes"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="0,0,0,20"
                   Text="This document has unsaved changes. Do you want to save them before closing?"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource ForegroundBrush}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="90" Margin="0,0,8,0" Padding="12,6"
                    Content="Save" IsDefault="True" Click="Save_Click" />
            <Button MinWidth="90" Margin="0,0,8,0" Padding="12,6"
                    Content="Don't Save" Click="Discard_Click" />
            <Button MinWidth="80" Padding="12,6"
                    Content="Cancel" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>

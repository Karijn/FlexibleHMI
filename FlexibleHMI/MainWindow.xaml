<Window x:Class="FlexibleHMI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pg="clr-namespace:WpfPropertyGrid;assembly=WpfPropertyGrid"
        xmlns:local="clr-namespace:FlexibleHMI"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="450" Width="800" MinHeight="360" MinWidth="600"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        Closing="Window_Closing">

    <Window.Resources>
        <Geometry x:Key="NewIcon">M4,1 H12 L17,6 V19 H4 Z M12,1 V6 H17</Geometry>
        <Geometry x:Key="OpenIcon">M2,4 H8 L10,6 H18 V18 H2 Z</Geometry>
        <Geometry x:Key="SaveIcon">M3,2 H17 L19,4 V18 H3 Z M6,2 V7 H15 V2</Geometry>
        <Geometry x:Key="AddIcon">M9,3 H11 V9 H17 V11 H11 V17 H9 V11 H3 V9 H9 Z</Geometry>
        <Geometry x:Key="BeforeIcon">M4,3 H6 V17 H4 Z M8,9 H17 V11 H8 L11,14 L10,15 L5,10 L10,5 L11,6 Z</Geometry>
        <Geometry x:Key="AfterIcon">M15,3 H17 V17 H15 Z M12,5 L17,10 L12,15 L11,14 L14,11 H5 V9 H14 L11,6 Z</Geometry>
        <Geometry x:Key="DeleteIcon">M3,6 H5 L6,18 H14 L15,6 H17 L16,20 H4 Z M2,3 H18 V5 H2 Z M7,1 H13 L14,3 H6 Z</Geometry>
        <Geometry x:Key="UpIcon">M9,4 H11 V13 H16 L10,19 L4,13 H9 Z</Geometry>
        <Geometry x:Key="DownIcon">M9,2 H11 V11 H16 L10,17 L4,11 H9 Z</Geometry>
        <Geometry x:Key="FirstIcon">M3,3 H5 V17 H3 Z M10,4 L16,10 L10,16 L9,14 L12,11 H6 V9 H12 L9,6 Z</Geometry>
        <Geometry x:Key="LastIcon">M15,3 H17 V17 H15 Z M10,4 L11,6 L8,9 H14 V11 H8 L11,14 L10,16 L4,10 Z</Geometry>
        <Geometry x:Key="ExpandIcon">M3,3 H17 V17 H3 Z M9,5 H11 V9 H15 V11 H11 V15 H9 V11 H5 V9 H9 Z</Geometry>
        <Geometry x:Key="CollapseIcon">M3,3 H17 V17 H3 Z M5,9 H15 V11 H5 Z</Geometry>
        <Geometry x:Key="ExpandAllIcon">M2,2 H15 V4 H4 V15 H2 Z M5,5 H18 V18 H5 Z M10,7 H12 V10 H15 V12 H12 V15 H10 V12 H7 V10 H10 Z</Geometry>
        <Geometry x:Key="CollapseAllIcon">M2,2 H15 V4 H4 V15 H2 Z M5,5 H18 V18 H5 Z M7,10 H16 V12 H7 Z</Geometry>
        <Geometry x:Key="MoveOutIcon">M3,9 H12 V6 L18,12 L12,18 V15 H3 Z</Geometry>
        <Geometry x:Key="MoveInIcon">M3,9 H12 V6 L18,12 L12,18 V15 H3 Z</Geometry>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:BoolToColorBrushConverter x:Key="BoolToColorBrushConverter" />


        <Style x:Key="MenuIconStyle" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{DynamicResource ForegroundBrush}" />
        </Style>

        <DataTemplate DataType="{x:Type local:LeafItemNode}">
            <Border BorderThickness="1"
                    BorderBrush="{Binding Path=IsCurrent, ConverterParameter=Red;Transparent, Converter={StaticResource BoolToColorBrushConverter}}"
                    Background="Transparent"
                    Margin="5" Padding="5" CornerRadius="5"
                    >
                <StackPanel >
                    <TextBlock Text="{Binding Path=Name}" />
                    <TextBlock Text="{Binding Path=ChildRule}"/>
                </StackPanel>
            </Border>
        </DataTemplate>


        <DataTemplate DataType="{x:Type local:CollectionItemNode}">
            <Border BorderThickness="1"
                    BorderBrush="{Binding Path=IsCurrent, ConverterParameter=Red;Transparent, Converter={StaticResource BoolToColorBrushConverter}}"
                    Background="Transparent"
                    Margin="5" Padding="5" CornerRadius="5"
                    >

                <Grid RowDefinitions="Auto Auto *" ColumnDefinitions="50 *">
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Path=Name}" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Path=ChildRule}"/>
                    <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Children}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ItemsPresenter/>
                            </ControlTemplate>
                        </ItemsControl.Template>
                    </ItemsControl>

                </Grid>
            </Border>
        </DataTemplate>


        <DataTemplate DataType="{x:Type local:SingleChildItemNode}">
            <Border BorderThickness="1"
                    BorderBrush="{Binding Path=IsCurrent, ConverterParameter=Red;Transparent, Converter={StaticResource BoolToColorBrushConverter}}"
                    Background="Transparent"
                    Margin="5" Padding="5" CornerRadius="5"
                    >
                <Grid RowDefinitions="Auto Auto *" ColumnDefinitions="50 *">
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Path=Name}" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Path=ChildRule}"/>
                    <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Children}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ItemsPresenter/>
                            </ControlTemplate>
                        </ItemsControl.Template>
                    </ItemsControl>

                </Grid>
            </Border>
        </DataTemplate>

        <CollectionViewSource x:Key="ListBoxItems" 
                              Source="{Binding Path=AvailableItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
            
        </CollectionViewSource>

    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewDocumentCommand}" />
        <KeyBinding Key="X" Modifiers="Control" Command="{Binding CutItemCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyItemCommand}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteItemCommand}" />
        <KeyBinding Key="V" Modifiers="Control+Shift" Command="{Binding PasteAfterItemCommand}" />
        <KeyBinding Key="V" Modifiers="Control+Alt" Command="{Binding PasteBeforeItemCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteItemCommand}" />
        <KeyBinding Key="Up" Modifiers="Control" Command="{Binding MoveUpItemCommand}" />
        <KeyBinding Key="Down" Modifiers="Control" Command="{Binding MoveDownItemCommand}" />
        <KeyBinding Key="Left" Modifiers="Control" Command="{Binding MoveToParentCommand}" />
        <KeyBinding Key="Right" Modifiers="Control" Command="{Binding MoveToChildCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenDocumentCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveDocumentCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding AddItemCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control+Shift" Command="{Binding AddAfterItemCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control+Alt" Command="{Binding AddBeforeItemCommand}" />
    </Window.InputBindings>

    <Grid Margin="16"
          Background="{DynamicResource WindowBackgroundBrush}"
          RowDefinitions="Auto 50 Auto * Auto">

        <!-- Menu -->
        <Menu Grid.Row="0" 
              Margin="-16,-16,-16,8">

            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Command="{Binding NewDocumentCommand}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource MenuIconStyle}" Data="{StaticResource NewIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Command="{Binding OpenDocumentCommand}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource MenuIconStyle}" Data="{StaticResource OpenIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Recent _Files" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource MenuIconStyle}" Data="{StaticResource OpenIcon}" />
                    </MenuItem.Icon>
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}" />
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveDocumentCommand}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource MenuIconStyle}" Data="{StaticResource SaveIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save _As..." Command="{Binding SaveDocumentAsCommand}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource MenuIconStyle}" Data="{StaticResource SaveIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Tree">
                <MenuItem Header="_Add selected item as child" InputGestureText="Ctrl+Enter" Command="{Binding AddItemCommand}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource MenuIconStyle}" Data="{StaticResource AddIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Add selected item _after" InputGestureText="Ctrl+Shift+Enter" Command="{Binding AddAfterItemCommand}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource MenuIconStyle}" Data="{StaticResource AfterIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Add selected item _before" InputGestureText="Ctrl+Alt+Enter" Command="{Binding AddBeforeItemCommand}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource MenuIconStyle}" Data="{StaticResource BeforeIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Delete selected item" InputGestureText="Delete" Command="{Binding DeleteItemCommand}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource MenuIconStyle}" Data="{StaticResource DeleteIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Move _up" InputGestureText="Ctrl+Up" Command="{Binding MoveUpItemCommand}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource MenuIconStyle}" Data="{StaticResource UpIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Move _down" InputGestureText="Ctrl+Down" Command="{Binding MoveDownItemCommand}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource MenuIconStyle}" Data="{StaticResource DownIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Move out one _level" InputGestureText="Ctrl+Left" Command="{Binding MoveToParentCommand}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource MenuIconStyle}" Data="{StaticResource MoveOutIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Move under _previous sibling" InputGestureText="Ctrl+Right" Command="{Binding MoveToChildCommand}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource MenuIconStyle}" Data="{StaticResource MoveInIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Move to _first child position" Command="{Binding MoveToFirstChildCommand}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource MenuIconStyle}" Data="{StaticResource FirstIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Move to _last child position" Command="{Binding MoveToLastChildCommand}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource MenuIconStyle}" Data="{StaticResource LastIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Expand selected _node" Command="{Binding ExpandSelectedNodeCommand}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource MenuIconStyle}" Data="{StaticResource ExpandIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Collapse selected n_ode" Command="{Binding CollapseSelectedNodeCommand}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource MenuIconStyle}" Data="{StaticResource CollapseIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Expand _all nodes" Command="{Binding ExpandAllNodesCommand}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource MenuIconStyle}" Data="{StaticResource ExpandAllIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Collapse a_ll nodes" Command="{Binding CollapseAllNodesCommand}">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource MenuIconStyle}" Data="{StaticResource CollapseAllIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Theme">
                    <MenuItem Header="Light" IsCheckable="True" IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                              Command="{Binding UseLightThemeCommand}" />
                    <MenuItem Header="Dark" IsCheckable="True" IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                              Command="{Binding UseDarkThemeCommand}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Load _last document at startup"
                          IsCheckable="True" IsChecked="{Binding AutoLoadLastDocument, Mode=TwoWay}" />
                <MenuItem Header="Show toolbar _text"
                          IsCheckable="True" IsChecked="{Binding ShowToolbarText, Mode=TwoWay}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About Flexible HMI" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBar Grid.Row="1"  Margin="-16,0,-16,8"
                 Background="{DynamicResource SurfaceBrush}"
                 Foreground="{DynamicResource ForegroundBrush}"
                 BorderBrush="{DynamicResource BorderBrush}">
            <ToolBar.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility"
                            Value="{Binding DataContext.ShowToolbarText, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Style>
            </ToolBar.Resources>
            <Button ToolTip="New document (Ctrl+N)" Command="{Binding NewDocumentCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="16" Height="16" Margin="0,0,4,0" Fill="{DynamicResource ForegroundBrush}" Data="{StaticResource NewIcon}" />
                    <TextBlock Text="New" />
                </StackPanel>
            </Button>
            <Button ToolTip="Open document (Ctrl+O)" Command="{Binding OpenDocumentCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="16" Height="16" Margin="0,0,4,0" Fill="{DynamicResource ForegroundBrush}" Data="{StaticResource OpenIcon}" />
                    <TextBlock Text="Open" />
                </StackPanel>
            </Button>
            <Button ToolTip="Save document (Ctrl+S)" Command="{Binding SaveDocumentCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="16" Height="16" Margin="0,0,4,0" Fill="{DynamicResource ForegroundBrush}" Data="{StaticResource SaveIcon}" />
                    <TextBlock Text="Save" />
                </StackPanel>
            </Button>
            <Button ToolTip="Save document as" 
                    Command="{Binding SaveDocumentAsCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="16" Height="16" 
                          Margin="0,0,4,0" Fill="{DynamicResource ForegroundBrush}" 
                          Data="{StaticResource SaveIcon}" />
                    <TextBlock Text="Save As" />
                </StackPanel>
            </Button>
            <Separator />
            <Button ToolTip="Add selected item as child (Ctrl+Enter)" 
                    Command="{Binding AddItemCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="16" Height="16" 
                          Margin="0,0,4,0" Fill="{DynamicResource ForegroundBrush}" 
                          Data="{StaticResource AddIcon}" />
                    <TextBlock Text="Add child" />
                </StackPanel>
            </Button>
            <Button ToolTip="Add selected item before (Ctrl+Alt+Enter)" 
                    Command="{Binding AddBeforeItemCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="16" Height="16" 
                          Margin="0,0,4,0" Fill="{DynamicResource ForegroundBrush}" 
                          Data="{StaticResource BeforeIcon}" />
                    <TextBlock Text="Add before" />
                </StackPanel>
            </Button>
            <Button ToolTip="Add selected item after (Ctrl+Shift+Enter)"
                    Command="{Binding AddAfterItemCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="16" Height="16" 
                          Margin="0,0,4,0" Fill="{DynamicResource ForegroundBrush}" 
                          Data="{StaticResource AfterIcon}" />
                    <TextBlock Text="Add after" />
                </StackPanel>
            </Button>
            <Button ToolTip="Delete selected item" 
                    Command="{Binding DeleteItemCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="16" Height="16" 
                          Margin="0,0,4,0" Fill="{DynamicResource ForegroundBrush}" 
                          Data="{StaticResource DeleteIcon}" />
                    <TextBlock Text="Delete" />
                </StackPanel>
            </Button>
            <Separator />
            <Button ToolTip="Move selected item up (Ctrl+Up)" 
                    Command="{Binding MoveUpItemCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="16" Height="16" 
                          Margin="0,0,4,0" Fill="{DynamicResource ForegroundBrush}" 
                          Data="{StaticResource UpIcon}" />
                    <TextBlock Text="Move up" />
                </StackPanel>
            </Button>
            <Button ToolTip="Move selected item down (Ctrl+Down)" 
                    Command="{Binding MoveDownItemCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="16" Height="16" 
                          Margin="0,0,4,0" Fill="{DynamicResource ForegroundBrush}" 
                          Data="{StaticResource DownIcon}" />
                    <TextBlock Text="Move down" />
                </StackPanel>
            </Button>
            <Separator />
            <Button ToolTip="Move selected item to the first child position of its parent" 
                    Command="{Binding MoveToFirstChildCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="16" Height="16" 
                          Margin="0,0,4,0" Fill="{DynamicResource ForegroundBrush}" 
                          Data="{StaticResource FirstIcon}" />
                    <TextBlock Text="First child" />
                </StackPanel>
            </Button>
            <Button ToolTip="Move selected item to the last child position of its parent" 
                    Command="{Binding MoveToLastChildCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="16" Height="16" 
                          Margin="0,0,4,0" Fill="{DynamicResource ForegroundBrush}"
                          Data="{StaticResource LastIcon}" />
                    <TextBlock Text="Last child" />
                </StackPanel>
            </Button>
            <Separator />
            <Button ToolTip="Expand the selected node" 
                    Command="{Binding ExpandSelectedNodeCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="16" Height="16" 
                          Margin="0,0,4,0" Fill="{DynamicResource ForegroundBrush}" 
                          Data="{StaticResource ExpandIcon}" />
                    <TextBlock Text="Expand node" />
                </StackPanel>
            </Button>
            <Button ToolTip="Collapse the selected node" 
                    Command="{Binding CollapseSelectedNodeCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="16" Height="16" 
                          Margin="0,0,4,0" Fill="{DynamicResource ForegroundBrush}" 
                          Data="{StaticResource CollapseIcon}" />
                    <TextBlock Text="Collapse node" />
                </StackPanel>
            </Button>
            <Button ToolTip="Expand all nodes" 
                    Command="{Binding ExpandAllNodesCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="16" Height="16" 
                          Margin="0,0,4,0" Fill="{DynamicResource ForegroundBrush}" 
                          Data="{StaticResource ExpandAllIcon}" />
                    <TextBlock Text="Expand all" />
                </StackPanel>
            </Button>
            <Button ToolTip="Collapse all nodes" 
                    Command="{Binding CollapseAllNodesCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="16" Height="16" 
                          Margin="0,0,4,0" Fill="{DynamicResource ForegroundBrush}"
                          Data="{StaticResource CollapseAllIcon}" />
                    <TextBlock Text="Collapse all" />
                </StackPanel>
            </Button>
        </ToolBar>

        <Grid Grid.Row="3" HorizontalAlignment="Stretch" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPanelColumn" Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightPanelColumn" Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- -->
            <Expander ExpandDirection="Right"
                      IsExpanded="{Binding IsLeftExpanded, Mode=TwoWay}"
                      d:IsExpanded="True"
                      Expanded="LeftPanel_Expanded"
                      Collapsed="LeftPanel_Collapsed"
                      MouseEnter="LeftPanel_MouseEnter"
                      MouseLeave="LeftPanel_Expander_MouseLeave">
                <Expander.Style>
                    <Style TargetType="{x:Type Expander}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsMainContentFullScreen, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                                         Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <Expander.Header>
                    <TextBlock Text="Left panel" Margin="4,0,0,0">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Expander.Header>

                <!--===========================================-->
                <!-- -->
                <Grid Grid.Column="0" RowDefinitions="* Auto *">

                    
                    <!--<ListBox Grid.Row="0" ItemsSource="{Binding AvailableItems}"
                     SelectedItem="{Binding SelectedItemOption, Mode=TwoWay}"
                     PreviewMouseLeftButtonDown="DragSource_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="DragSource_PreviewMouseMove">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4" RowDefinitions="auto *" ColumnDefinitions="auto auto">
                                    <Image Width="16" Height="16" Margin="0 0 5 0" Source="{Binding Image}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Description}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>-->
                    <ListBox PreviewMouseLeftButtonDown="DragSource_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="DragSource_PreviewMouseMove"
                             Margin="5,5,5,5"
                             ItemsSource="{Binding Source={StaticResource ListBoxItems}}"
                             SelectedIndex="-1"
                             SelectedItem="{Binding SelectedBranch}">

                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </GroupStyle.Panel>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <Expander Padding="0"                                           
                                                              BorderThickness="0"
                                                              Header="{Binding Name}"
                                                              IsExpanded="True">
                                                        <ItemsPresenter/>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="16"
                                       Height="16"
                                       Source="{Binding Image}"/>
                                            <TextBlock Margin="8,0,0,0" Text="{Binding Name}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>


                    <GridSplitter Grid.Row="1" Height="5" 
                                  HorizontalAlignment="Stretch"                       
                                  Background="Gray"
/>

                    <Grid Grid.Row="2" Margin="5, 5, 5, 0">
                        <TreeView x:Name="ItemTree"
                                  Grid.Row="0"
                                  ItemsSource="{Binding RootItems}"
                                  AllowDrop="True"
                                  SelectedItemChanged="TreeView_SelectedItemChanged"
                                  PreviewMouseLeftButtonDown="DragSource_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="DragSource_PreviewMouseMove"
                                  DragEnter="ItemTree_DragOver"
                                  DragOver="ItemTree_DragOver"
                                  DragLeave="ItemTree_DragLeave"
                                  Drop="ItemTree_Drop">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Border x:Name="ItemRow" Padding="2" CornerRadius="2"
                                Background="{DynamicResource SurfaceBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="16" Height="16" Margin="0 0 5 0" Source="{Binding Image}"/>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource MutedForegroundBrush}"
                                           Text="{Binding ChildRule}" />
                                        </StackPanel>
                                    </Border>
                                    <HierarchicalDataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="ItemRow" Property="Background"
                                        Value="{DynamicResource SelectionBrush}" />
                                        </DataTrigger>
                                    </HierarchicalDataTemplate.Triggers>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <Border x:Name="DeleteBin"
                    Grid.Row="0"
                    Width="42"
                    Height="42"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,28,0"
                    Padding="8,4"
                    Background="{DynamicResource DeleteBinBrush}"
                    BorderBrush="{DynamicResource DeleteBinBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    AllowDrop="True"
                    DragEnter="DeleteBin_DragOver"
                    DragOver="DeleteBin_DragOver"
                    DragLeave="DeleteBin_DragLeave"
                    Drop="DeleteBin_Drop">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Width="20" Height="22" Margin="0,0,0,0"
                          Fill="{DynamicResource ForegroundBrush}"
                          Stretch="Uniform"
                          Data="M3,6 L5,6 L5.8,20 L14.2,20 L15,6 L17,6 L16,22 L4,22 Z M2,3 L18,3 L18,5 L2,5 Z M7,1 L13,1 L14,3 L6,3 Z M7,8 L9,8 L9,18 L7,18 Z M11,8 L13,8 L13,18 L11,18 Z" />
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
            </Expander>
            <!-- -->
            <GridSplitter Grid.Column="1" Width="5" 
                          Background="Gray"
                          ResizeBehavior="PreviousAndNext"
                          VerticalAlignment="Stretch"
                          DragDelta="LeftPanelSplitter_DragDelta"
                          DragCompleted="LeftPanelSplitter_DragCompleted"                          />

            <Grid Grid.Column="2">
                <ItemsControl ItemsSource="{Binding RootItems}" >
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer >
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                </ItemsControl>
            </Grid>
            <!-- =========================================== -->

            <GridSplitter Grid.Column="3"
                      Width="5"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="Gray"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="False"
                      DragDelta="RightPanelSplitter_DragDelta"
                      DragCompleted="RightPanelSplitter_DragCompleted">
                <GridSplitter.Style>
                    <Style TargetType="{x:Type GridSplitter}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRightExpanded}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMainContentFullScreen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <Expander ExpandDirection="Left" Grid.Column="4"
              IsExpanded="{Binding IsRightExpanded, Mode=TwoWay}"
              Expanded="RightPanel_Expanded"
              Collapsed="RightPanel_Collapsed"
              MouseEnter="RightPanel_MouseEnter"
              MouseLeave="RightPanel_Expander_MouseLeave">
                <Expander.Style>
                    <Style TargetType="{x:Type Expander}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsMainContentFullScreen, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <Expander.Header>
                    <TextBlock Text="Right panel" Margin="4,0,0,0">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Expander.Header>

                <pg:PropertyGrid HorizontalAlignment="Stretch"
                                 VerticalAlignment="Top" 
                                 SelectedObject="{Binding SelectedTreeItem}" />
            </Expander>
        </Grid>

        
        <StatusBar Grid.Row="4" Margin="-16,8,-16,-16"
                   Background="{DynamicResource SurfaceBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Foreground="#FFB3261E" FontWeight="SemiBold" Text="Modified">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalContentAlignment="Right">
                <TextBlock Text="{Binding CurrentFilePath}"
                           ToolTip="{Binding CurrentFilePath}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalContentAlignment="Right">
                <TextBlock Text="{Binding DropStatus}"
                           ToolTip="{Binding DropStatus}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalContentAlignment="Right">
                <TextBlock Text="{Binding AddTargetDescription}"
                           ToolTip="{Binding AddTargetDescription}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock Text=""
                           ToolTip="" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

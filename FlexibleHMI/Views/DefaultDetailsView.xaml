<UserControl x:Class="FlexibleHMI.Views.DefaultDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:pg="clr-namespace:WpfPropertyGrid;assembly=WpfPropertyGrid"
             xmlns:local="clr-namespace:FlexibleHMI.Views" xmlns:viewmodels="clr-namespace:FlexibleHMI.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <pg:PropertyGrid HorizontalAlignment="Stretch"
                                 VerticalAlignment="Top" 
                                 SelectedObject="{Binding}" />

</UserControl>

<UserControl x:Class="PropertyManager.UI.PropertyManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PropertyManager.UI"
             d:DataContext="{d:DesignInstance Type=local:PropertyManagerViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             MinWidth="600">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="0,0,0,12" FontSize="20" FontWeight="SemiBold"
                   Text="Property Manager" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Orientation="Horizontal">
                    <Button Padding="10,5" Content="New property" Command="{Binding NewPropertyCommand}" />
                    <Button Margin="8,0,0,0" Padding="10,5" Content="Delete selected"
                            Command="{Binding DeletePropertyCommand}"
                            IsEnabled="{Binding IsEditing}" />
                </StackPanel>
                <ListView ItemsSource="{Binding Properties}" SelectedItem="{Binding SelectedProperty, Mode=TwoWay}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="150" />
                            <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="90" />
                            <GridViewColumn Header="Value" DisplayMemberBinding="{Binding Value}" Width="150" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Margin="0,0,0,8" FontSize="16" FontWeight="SemiBold"
                           Text="Create or edit property" />
                <TextBlock Margin="0,0,0,4" Text="Name" />
                <TextBox Margin="0,0,0,10" Padding="6" Text="{Binding PropertyName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,0,0,4" Text="Type" />
                <ComboBox Margin="0,0,0,10" Padding="6" ItemsSource="{Binding PropertyTypes}"
                          SelectedItem="{Binding SelectedType, Mode=TwoWay}" />

                <TextBlock Margin="0,0,0,4" Text="Value" />
                <TextBox Padding="6" Text="{Binding ValueInput, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedType}" Value="Boolean">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <CheckBox Margin="0,0,0,10" Content="True"
                          IsChecked="{Binding BooleanValue, Mode=TwoWay}">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedType}" Value="Boolean">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>

                <TextBlock Margin="0,0,0,10" Foreground="Firebrick" TextWrapping="Wrap"
                           Text="{Binding ErrorMessage}" />
                <Button Padding="10,6" HorizontalAlignment="Left" Content="Save property"
                        Command="{Binding SavePropertyCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

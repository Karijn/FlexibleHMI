<UserControl x:Class="Inputs.UI.InputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Inputs.UI" MinWidth="260">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <local:OptionSelectedConverter x:Key="OptionSelected" />
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers><Trigger Property="Validation.HasError" Value="True"><Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" /></Trigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="12">
        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
        <WrapPanel Margin="0,0,0,8">
            <TextBlock Text="Property (X for joystick)" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Width="160" IsEditable="True" ItemsSource="{Binding PropertyNames}" Text="{Binding PropertyName, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Text="Y property" VerticalAlignment="Center" Margin="8,0,6,0" Visibility="{Binding IsJoystick, Converter={StaticResource Visible}}" />
            <ComboBox Width="160" IsEditable="True" ItemsSource="{Binding PropertyNames}" Text="{Binding YPropertyName, UpdateSourceTrigger=LostFocus}" Visibility="{Binding IsJoystick, Converter={StaticResource Visible}}" />
        </WrapPanel>
        <WrapPanel Margin="0,0,0,8" Visibility="{Binding IsNumeric, Converter={StaticResource Visible}}">
            <TextBlock Text="Minimum" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Width="75" Text="{Binding Minimum, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
            <TextBlock Text="Maximum" VerticalAlignment="Center" Margin="8,0,4,0" />
            <TextBox Width="75" Text="{Binding Maximum, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
        </WrapPanel>
        <StackPanel Visibility="{Binding IsChoice, Converter={StaticResource Visible}}" Margin="0,0,0,8">
            <TextBlock Text="Options (one String value per line)" />
            <TextBox Width="240" Height="60" HorizontalAlignment="Left" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding OptionsText, UpdateSourceTrigger=LostFocus}" />
        </StackPanel>
        <TextBlock Foreground="Firebrick" TextWrapping="Wrap" Text="{Binding Status}" Margin="0,0,0,8" />
        <ComboBox Width="200" HorizontalAlignment="Left" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAvailable}" Visibility="{Binding IsComboBox, Converter={StaticResource Visible}}" />
        <CheckBox Content="{Binding Name}" IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAvailable}" Visibility="{Binding IsCheckBox, Converter={StaticResource Visible}}" />
        <ToggleButton Width="100" Height="40" HorizontalAlignment="Left" Content="{Binding OnOffLabel}" IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAvailable}" Visibility="{Binding IsOnOffButton, Converter={StaticResource Visible}}" />
        <ItemsControl ItemsSource="{Binding Options}" IsEnabled="{Binding IsAvailable}" Visibility="{Binding IsRadioButtonSet, Converter={StaticResource Visible}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton Content="{Binding}" Command="{Binding DataContext.SelectOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <RadioButton.IsChecked>
                            <MultiBinding Converter="{StaticResource OptionSelected}" Mode="OneWay">
                                <Binding /><Binding Path="DataContext.SelectedOption" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            </MultiBinding>
                        </RadioButton.IsChecked>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Slider Width="240" HorizontalAlignment="Left" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" SmallChange="{Binding NumericStep}" Value="{Binding NumericValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAvailable}" Visibility="{Binding IsSlider, Converter={StaticResource Visible}}" />
        <local:PotentiometerControl Width="120" Height="120" HorizontalAlignment="Left" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Step="{Binding NumericStep}" Value="{Binding NumericValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAvailable}" Visibility="{Binding IsPotentiometer, Converter={StaticResource Visible}}" AutomationProperties.Name="Potentiometer" ToolTip="Drag around the dial or use the arrow keys." />
        <local:JoystickControl Width="160" Height="160" HorizontalAlignment="Left" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" XStep="{Binding NumericStep}" YStep="{Binding YStep}" XValue="{Binding NumericValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" YValue="{Binding YValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAvailable}" Visibility="{Binding IsJoystick, Converter={StaticResource Visible}}" AutomationProperties.Name="Joystick" ToolTip="Drag the handle or use the arrow keys." />
        <TextBlock Margin="0,4,0,0" Visibility="{Binding IsNumeric, Converter={StaticResource Visible}}" Text="{Binding NumericValue, StringFormat=Value: {0:0.###}}" />
        <TextBlock Visibility="{Binding IsJoystick, Converter={StaticResource Visible}}" Text="{Binding YValue, StringFormat=Y: {0:0.###}}" />
    </StackPanel>
</UserControl>

<UserControl x:Class="Inputs.UI.JoyStick.JoystickView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Inputs.UI"
             xmlns:joystick="clr-namespace:Inputs.UI.JoyStick"
             >
    <!--<local:InputView>
        <local:InputView.InputTemplate>
            <DataTemplate>-->
                <joystick:JoystickControl Width="160" Height="160"
                                       HorizontalAlignment="Left"
                                       Minimum="{Binding Minimum}"
                                       Maximum="{Binding Maximum}"
                                       XStep="{Binding NumericStep}"
                                       YStep="{Binding YStep}"
                                       XValue="{Binding NumericValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       YValue="{Binding YValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       IsEnabled="{Binding IsAvailable}"
                                       AutomationProperties.Name="Joystick"
                                       ToolTip="Drag the handle or use the arrow keys." />
            <!--</DataTemplate>
        </local:InputView.InputTemplate>
    </local:InputView>-->
</UserControl>

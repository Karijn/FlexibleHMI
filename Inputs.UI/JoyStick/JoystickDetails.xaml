<UserControl x:Class="Inputs.UI.JoyStick.JoystickDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Inputs.UI.JoyStick"
             xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
          ColumnDefinitions="Auto *"
          >

        <TextBlock Grid.ColumnSpan="2"
                   Text="Potentiometer Details" 
                   HorizontalAlignment="Center" 
                   FontSize="20"
                   Height="32"/>

        <TextBlock Grid.Row="1" 
                   Margin="2 0 5 0"
                   Text="Name" 
                   VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name}" 
                 FontSize="16" 
                 FontWeight="SemiBold" 
                 />

        <TextBlock Grid.Row="2"
                   Margin="2 0 5 0"
                   Text="Minimum" 
                   VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1"  
                 Text="{Binding Minimum, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />

        <TextBlock Grid.Row="3" Grid.Column="0" 
                   Margin="2 0 5 0"
                   Text="Maximum" 
                   VerticalAlignment="Center" />
        <TextBox Grid.Row="3" Grid.Column="1" 
                 Text="{Binding Maximum, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />

        <TextBlock Grid.Row="4" Grid.Column="0" 
                   Margin="2 0 5 0"
                   Text="Value" 
                   VerticalAlignment="Center" />
        <TextBox Grid.Row="4" Grid.Column="1" 
                 Text="{Binding NumericValue, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />

        <TextBlock Grid.Row="5" Grid.Column="0" 
                   Margin="2 0 5 0"
                   Text="Step" 
                   VerticalAlignment="Center" />
        <TextBox Grid.Row="5" Grid.Column="1" 
                 Text="{Binding Step, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />

        <TextBlock Grid.Row="6" 
                   Margin="2 0 5 0"
                   Text="Property X" 
                   VerticalAlignment="Center" />
        <ComboBox Grid.Row="6" Grid.Column="1" 
                  IsEditable="True" 
                  ItemsSource="{Binding PropertyNames}" 
                  Text="{Binding PropertyName, UpdateSourceTrigger=LostFocus}" />

        <TextBlock Grid.Row="7" 
                   Margin="2 0 5 0"
                   Text="Property Y" 
                   VerticalAlignment="Center" />
        <ComboBox Grid.Row="7" Grid.Column="1" 
                  IsEditable="True" 
                  ItemsSource="{Binding PropertyNames}" 
                  Text="{Binding YPropertyName, UpdateSourceTrigger=LostFocus}" />



        <TextBlock Grid.Row="8" Grid.Column="0" 
                   Margin="2 0 5 0"
                   Text="Back Color" 
                   VerticalAlignment="Center" />
        <TextBox Grid.Row="8" Grid.Column="1" 
                 Text="{Binding BackColor, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />


        <TextBlock Grid.Row="9" Grid.Column="0" 
                   Margin="2 0 5 0"
                   Text="Fore Color" 
                   VerticalAlignment="Center" />
        <TextBox Grid.Row="9" Grid.Column="1" 
                 Text="{Binding ForeColor, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />


        <TextBlock Grid.Row="10" Grid.Column="0" 
                   Margin="2 0 5 0"
                   Text="Border Color" 
                   VerticalAlignment="Center" />
        <TextBox Grid.Row="10" Grid.Column="1" 
                 Text="{Binding BorderColor, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />

        <Label Grid.Row="11" Grid.Column="0">Portable Color Picker, default look</Label>
        <colorpicker:PortableColorPicker Grid.Row="11" Grid.Column="1" 
                                         Width="40" Height="20"
                                         ColorState="{Binding ElementName=ForeColor, Path=ColorState, Mode=TwoWay, Delay=10}"
                                         SecondColorState="{Binding ElementName=BackColor, Path=SecondColorState, Mode=TwoWay}" />
        <TextBlock  Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2"
                    TextWrapping="Wrap" 
                    Margin="5">Portable Color Picker, styled, alpha hidden, transparent hint color, hsv/hsl fractional part hidden</TextBlock>

    </Grid>


</UserControl>

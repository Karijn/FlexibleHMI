<UserControl x:Class="Inputs.UI.InputDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8">
            <TextBlock Text="{Binding Name}" FontSize="20" Margin="0,0,0,8" />
            <TextBlock Text="Property" />
            <ComboBox x:Name="PropertyEditor" IsEditable="True" ItemsSource="{Binding PropertyNames}"
                      Text="{Binding PropertyName, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
            <ContentControl Content="{Binding ChoiceSettings}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Options (one String value per line)" />
                            <TextBox x:Name="OptionsEditor" Height="60" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     Text="{Binding OptionsText, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <TextBlock Foreground="Firebrick" TextWrapping="Wrap" Text="{Binding Status}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

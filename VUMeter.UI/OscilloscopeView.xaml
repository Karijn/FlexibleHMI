<UserControl x:Class="VUMeter.UI.OscilloscopeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VUMeter.UI" MinWidth="320">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        <local:LegendColorConverter x:Key="LegendColor" />
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="12">
        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}" />
        <TextBlock Margin="0,4" TextWrapping="Wrap" Text="Software sampling on the UI thread, nominally every 20 ms; fast signals can be missed. The plot has 10 horizontal and 8 vertical divisions." />
        <Grid Width="500" Height="320" HorizontalAlignment="Left" Margin="0,4,0,8">
            <local:OscilloscopePlot Model="{Binding}" />
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Padding="4" Background="#EAF5F5F5" CornerRadius="3"
                    Visibility="{Binding EffectiveShowLegend, Converter={StaticResource BooleanVisibility}}">
                <ScrollViewer MaxWidth="200" MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Channels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border Width="12" Height="12" Margin="0,0,6,0" Background="{Binding EffectiveColor, Converter={StaticResource LegendColor}}" BorderBrush="Gray" BorderThickness="1" />
                                    <TextBlock Text="{Binding InputProperty}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InputProperty}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
        <WrapPanel Margin="0,0,0,8">
            <CheckBox Content="Show legend (manual)" IsChecked="{Binding ShowLegend}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="Legend property" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Width="150" IsEditable="True" ItemsSource="{Binding BooleanPropertyNames}" Text="{Binding ShowLegendProperty, UpdateSourceTrigger=LostFocus}"
                      ToolTip="Leave blank to use the manual setting. An unavailable or non-Boolean property hides the legend." />
        </WrapPanel>
        <TextBlock Foreground="Firebrick" TextWrapping="Wrap" Text="{Binding LegendStatus}" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,6" />
        <WrapPanel>
            <StackPanel Width="100" Margin="0,0,8,6">
                <TextBlock Text="Seconds/div" />
                <TextBox Text="{Binding Speed, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
            </StackPanel>
            <StackPanel Width="150" Margin="0,0,8,6">
                <TextBlock Text="Speed property" />
                <ComboBox IsEditable="True" ItemsSource="{Binding NumericPropertyNames}" Text="{Binding SpeedProperty, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <CheckBox Content="Trigger enabled" IsChecked="{Binding TriggerEnabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <StackPanel Width="150" Margin="0,0,8,6">
                <TextBlock Text="Trigger enabled property" />
                <ComboBox IsEditable="True" ItemsSource="{Binding BooleanPropertyNames}" Text="{Binding TriggerEnabledProperty, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
        </WrapPanel>
        <WrapPanel>
            <StackPanel Width="150" Margin="0,0,8,6">
                <TextBlock Text="Trigger source property" />
                <ComboBox IsEditable="True" ItemsSource="{Binding NumericPropertyNames}" Text="{Binding TriggerSource, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Width="90" Margin="0,0,8,6">
                <TextBlock Text="Trigger level" />
                <TextBox Text="{Binding TriggerLevel, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
            </StackPanel>
            <StackPanel Width="150" Margin="0,0,8,6">
                <TextBlock Text="Level property" />
                <ComboBox IsEditable="True" ItemsSource="{Binding NumericPropertyNames}" Text="{Binding TriggerLevelProperty, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <CheckBox Content="Rising edge" IsChecked="{Binding RisingEdge}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <StackPanel Width="150" Margin="0,0,8,6">
                <TextBlock Text="Edge property (true=rising)" />
                <ComboBox IsEditable="True" ItemsSource="{Binding BooleanPropertyNames}" Text="{Binding RisingEdgeProperty, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
        </WrapPanel>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="Speed: 0.02-6 seconds/div. Amplitude is units/div (1e-9 to 1e9); offset is the value at screen center. Trigger captures one screen after a sampled level crossing and holds it until the next crossing. Blank bindings use manual values. Invalid bound settings are reported below." />
        <WrapPanel Margin="0,0,0,8">
            <Button Content="Add input" Command="{Binding AddChannelCommand}" Padding="8,4" Margin="0,0,8,0" />
            <Button Content="Clear" Command="{Binding ClearCommand}" Padding="8,4" />
        </WrapPanel>
        <ItemsControl ItemsSource="{Binding Channels}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <WrapPanel>
                                <StackPanel Width="150" Margin="0,0,8,4">
                                    <TextBlock Text="Input property" />
                                    <ComboBox IsEditable="True" ItemsSource="{Binding DataContext.NumericPropertyNames, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding InputProperty, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Width="100" Margin="0,0,8,4">
                                    <TextBlock Text="Color" />
                                    <ComboBox ItemsSource="{Binding DataContext.Colors, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Color}" />
                                </StackPanel>
                                <StackPanel Width="150" Margin="0,0,8,4">
                                    <TextBlock Text="Color property" />
                                    <ComboBox IsEditable="True" ItemsSource="{Binding DataContext.ColorPropertyNames, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding ColorProperty, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <Button Content="Remove" Padding="8,4" VerticalAlignment="Center" Command="{Binding DataContext.RemoveChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </WrapPanel>
                            <WrapPanel>
                                <StackPanel Width="100" Margin="0,0,8,4">
                                    <TextBlock Text="Units/div" />
                                    <TextBox Text="{Binding Amplitude, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                </StackPanel>
                                <StackPanel Width="150" Margin="0,0,8,4">
                                    <TextBlock Text="Amplitude property" />
                                    <ComboBox IsEditable="True" ItemsSource="{Binding DataContext.NumericPropertyNames, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding AmplitudeProperty, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Width="100" Margin="0,0,8,4">
                                    <TextBlock Text="Vertical offset" />
                                    <TextBox Text="{Binding Offset, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                </StackPanel>
                                <StackPanel Width="150" Margin="0,0,8,4">
                                    <TextBlock Text="Offset property" />
                                    <ComboBox IsEditable="True" ItemsSource="{Binding DataContext.NumericPropertyNames, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding OffsetProperty, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Foreground="Firebrick" Text="{Binding Status}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>

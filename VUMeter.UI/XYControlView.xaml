<UserControl x:Class="VUMeter.UI.XYControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VUMeter.UI" MinWidth="320">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        <local:LegendColorConverter x:Key="LegendColor" />
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="12">
        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}" />
        <TextBlock Foreground="Firebrick" TextWrapping="Wrap" Text="{Binding BoundsStatus}" />
        <Grid Width="450" Height="300" HorizontalAlignment="Left" Margin="0,4,0,8">
            <local:XYPlot Model="{Binding}" />
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Padding="4" Background="#EAF5F5F5" CornerRadius="3"
                    Visibility="{Binding EffectiveShowLegend, Converter={StaticResource BooleanVisibility}}">
                <ScrollViewer MaxWidth="200" MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Points}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border Width="12" Height="12" Margin="0,0,6,0" Background="{Binding EffectiveColor, Converter={StaticResource LegendColor}}" BorderBrush="Gray" BorderThickness="1" />
                                    <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"><Run Text="X: "/><Run Text="{Binding XProperty}"/><Run Text="  Y: "/><Run Text="{Binding YProperty}"/></TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBlock Foreground="Firebrick" TextWrapping="Wrap" Text="{Binding LegendStatus}" />
        <Button Content="Clear trails" Command="{Binding ClearTrailsCommand}" Padding="8,4" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>

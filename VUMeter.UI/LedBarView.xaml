<UserControl x:Class="VUMeter.UI.LedBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VUMeter.UI">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" HorizontalAlignment="Center" />
        <Border Background="#202020" Padding="6" CornerRadius="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="80" MinWidth="64">
            <local:LedBarDisplay SegmentCount="{Binding SegmentCount}" LitSegments="{Binding LitSegments}"
                                 ColumnCount="{Binding ColumnCount}" ColorStops="{Binding DisplayColorStops}" UseGradient="{Binding UseGradient}"
                                 Source="{Binding}" Revision="{Binding DisplayRevision}" VisibleRows="{Binding VisibleRows}" FadeMilliseconds="{Binding FadeMilliseconds}"
                                 AutomationProperties.Name="LED bar VU meter" />
        </Border>
    </DockPanel>
</UserControl>

<UserControl x:Class="VUMeter.UI.XYControlDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8">
            <TextBlock Text="XY Control" FontSize="20" Margin="0,0,0,8" />
            <TextBlock Text="X/Y axis limits" />
            <WrapPanel Margin="0,4,0,4">
                <StackPanel Width="75" Margin="0,0,8,4"><TextBlock Text="X min" /><TextBox x:Name="MinimumXEditor" Text="{Binding MinimumX, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" /></StackPanel>
                <StackPanel Width="75" Margin="0,0,8,4"><TextBlock Text="X max" /><TextBox Text="{Binding MaximumX, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" /></StackPanel>
                <StackPanel Width="75" Margin="0,0,8,4"><TextBlock Text="Y min" /><TextBox Text="{Binding MinimumY, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" /></StackPanel>
                <StackPanel Width="75" Margin="0,0,8,4"><TextBlock Text="Y max" /><TextBox Text="{Binding MaximumY, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" /></StackPanel>
            </WrapPanel>
            <TextBlock Foreground="Firebrick" TextWrapping="Wrap" Text="{Binding BoundsStatus}" />
            <CheckBox x:Name="ShowLegendEditor" Content="Show legend (manual)" IsChecked="{Binding ShowLegend}" Margin="0,0,0,8" />
            <TextBlock Text="Legend property" />
            <ComboBox x:Name="LegendPropertyEditor" IsEditable="True" ItemsSource="{Binding BooleanPropertyNames}" Text="{Binding ShowLegendProperty, UpdateSourceTrigger=LostFocus}"
                      ToolTip="Leave blank to use the manual setting. An unavailable or non-Boolean property hides the legend." />
            <TextBlock Foreground="Firebrick" TextWrapping="Wrap" Text="{Binding LegendStatus}" />
            <Button Content="Add point" Command="{Binding AddPointCommand}" Padding="8,4" HorizontalAlignment="Left" Margin="0,8" />
            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Text="Each point uses numeric X and Y properties. Optional appearance properties override the manual settings. Size is 1-100 pixels; trail length is 1-10000 positions. Invalid color or size hides the point; invalid trail settings clear the trail." />
            <ItemsControl ItemsSource="{Binding Points}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="X property" />
                                <ComboBox x:Name="XPropertyEditor" IsEditable="True" ItemsSource="{Binding DataContext.NumericPropertyNames, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding XProperty, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="Y property" />
                                <ComboBox x:Name="YPropertyEditor" IsEditable="True" ItemsSource="{Binding DataContext.NumericPropertyNames, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding YProperty, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="Color" />
                                <ComboBox x:Name="PointColorEditor" ItemsSource="{Binding DataContext.PointColors, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Color}" />
                                <TextBlock Text="Size (px)" />
                                <TextBox x:Name="PointSizeEditor" Text="{Binding Size, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                <TextBlock Text="Trail length" />
                                <TextBox Text="{Binding TrailLength, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                <CheckBox Content="Trail" IsChecked="{Binding ShowTrail}" Margin="0,4" />
                                <TextBlock Text="Color property" />
                                <ComboBox IsEditable="True" ItemsSource="{Binding DataContext.ColorPropertyNames, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding ColorProperty, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="Size property" />
                                <ComboBox IsEditable="True" ItemsSource="{Binding DataContext.NumericPropertyNames, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding SizeProperty, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="Trail enabled property" />
                                <ComboBox IsEditable="True" ItemsSource="{Binding DataContext.BooleanPropertyNames, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding TrailProperty, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="Trail length property" />
                                <ComboBox IsEditable="True" ItemsSource="{Binding DataContext.NumericPropertyNames, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding TrailLengthProperty, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                                <TextBlock Foreground="Firebrick" Text="{Binding AppearanceStatus}" TextWrapping="Wrap" />
                                <Button Content="Remove" Padding="8,4" Margin="0,4,0,0" HorizontalAlignment="Left" Command="{Binding DataContext.RemovePointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

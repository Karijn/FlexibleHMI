<UserControl x:Class="VUMeter.UI.VUMeterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320" MinHeight="240"
             Loaded="VUMeterView_Loaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
    </UserControl.Resources>
    <DockPanel Margin="12">
        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="500" Height="300" Padding="10" CornerRadius="8" Background="#4A3728">
                <Grid>
                    <Canvas x:Name="MeterCanvas" Background="#F5E6C8">
                        <ItemsControl x:Name="Needles" ItemsSource="{Binding Inputs}" Width="480" Height="280">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Line X1="250" Y1="280" X2="250" Y2="90" Stroke="{Binding Color}" StrokeThickness="3" StrokeStartLineCap="Round"
                                          Visibility="{Binding IsAvailable, Converter={StaticResource BooleanVisibility}}">
                                        <Line.RenderTransform><RotateTransform CenterX="250" CenterY="280" Angle="{Binding Angle}" /></Line.RenderTransform>
                                    </Line>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Ellipse x:Name="PivotCover" Width="16" Height="16" Fill="#1A1A1A"
                                 Canvas.Left="242" Canvas.Top="272" />
                    </Canvas>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5" Padding="4"
                            Background="#EAF5E6C8" CornerRadius="3">
                        <StackPanel>
                            <TextBlock Text="PEAK" FontSize="9" FontWeight="SemiBold" />
                            <ScrollViewer MaxHeight="85" MaxWidth="165" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Inputs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,1" ToolTip="{Binding Status}">
                                                <Ellipse Width="12" Height="12" Stroke="DarkRed" StrokeThickness="1" Margin="0,0,5,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="DarkRed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPeakActive}" Value="True">
                                                                    <Setter Property="Fill" Value="Red" />
                                                                    <Setter Property="Effect">
                                                                        <Setter.Value><DropShadowEffect Color="Red" BlurRadius="10" ShadowDepth="0" /></Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <Border Width="10" Height="10" Margin="0,0,5,0" Background="{Binding Color}" BorderBrush="Gray" BorderThickness="1" />
                                                <TextBlock Text="{Binding PropertyName}" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding DataContext.EffectiveShowLegend, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanVisibility}}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Viewbox>
    </DockPanel>
</UserControl>

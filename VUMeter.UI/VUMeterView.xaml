<UserControl x:Class="VUMeter.UI.VUMeterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320" MinHeight="240"
             Loaded="VUMeterView_Loaded">
    <DockPanel Margin="12">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" VerticalAlignment="Center">
            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Angle property" />
            <ComboBox Width="220" ItemsSource="{Binding NumericPropertyNames}"
                      SelectedItem="{Binding SelectedPropertyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </WrapPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Text="{Binding Status}" />
        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="500" Height="300" Padding="10" CornerRadius="8" Background="#4A3728">
                <Canvas x:Name="MeterCanvas" Background="#F5E6C8">
                    <Line x:Name="Needle" X1="250" Y1="280" X2="250" Y2="90"
                          Stroke="#1A1A1A" StrokeThickness="3" StrokeStartLineCap="Round">
                        <Line.RenderTransform>
                            <RotateTransform CenterX="250" CenterY="280" Angle="{Binding NeedleAngle}" />
                        </Line.RenderTransform>
                    </Line>
                    <Ellipse x:Name="PivotCover" Width="16" Height="16" Fill="#1A1A1A"
                             Canvas.Left="242" Canvas.Top="272" />
                    <Ellipse x:Name="PeakLed" Width="14" Height="14" Canvas.Left="430" Canvas.Top="205"
                             Stroke="DarkRed" StrokeThickness="1">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="DarkRed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPeakActive}" Value="True">
                                        <Setter Property="Fill" Value="Red" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="Red" BlurRadius="10" ShadowDepth="0" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="PEAK" FontSize="9" Canvas.Left="422" Canvas.Top="222" />
                </Canvas>
            </Border>
        </Viewbox>
    </DockPanel>
</UserControl>

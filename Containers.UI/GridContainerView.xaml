<UserControl x:Class="Containers.UI.GridContainerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Containers.UI">
    <UserControl.Resources>
        <local:GridDimensionConverter x:Key="GridDimension" />
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
    </UserControl.Resources>
    <Grid AllowDrop="True" Background="Transparent"
          Width="{Binding Width, Converter={StaticResource GridDimension}}"
          Height="{Binding Height, Converter={StaticResource GridDimension}}"
          MinWidth="{Binding Width, Converter={StaticResource GridDimension}, ConverterParameter=Minimum}"
          MinHeight="{Binding Height, Converter={StaticResource GridDimension}, ConverterParameter=Minimum}"
          DragOver="Grid_DragOver" Drop="Grid_Drop">
        <ItemsControl x:Name="Cells" ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <local:GridContainerPanel
                        RowCount="{Binding DataContext.RowCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        ColumnCount="{Binding DataContext.ColumnCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        EqualRowHeights="{Binding DataContext.EqualRowHeights, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        EqualColumnWidths="{Binding DataContext.EqualColumnWidths, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        ShowGridLines="{Binding DataContext.ShowGrid, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Grid.Row" Value="{Binding Row}" />
                    <Setter Property="Grid.Column" Value="{Binding Column}" />
                    <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}" />
                    <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="Transparent" Padding="4" Cursor="SizeAll"
                                Visibility="{Binding DataContext.ShowGrabber, RelativeSource={RelativeSource AncestorType=local:GridContainerView}, Converter={StaticResource BooleanVisibility}}"
                                ToolTip="Drag to move; hold Ctrl to copy" PreviewMouseLeftButtonDown="Handle_MouseDown" PreviewMouseMove="Handle_MouseMove">
                            <TextBlock Text="{Binding Node.Name, StringFormat=Move: {0}}" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <ContentControl Content="{Binding Node}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Empty grid. Add controls as children of this item." Opacity="0.6" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Cells.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>

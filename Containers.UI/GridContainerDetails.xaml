<UserControl x:Class="Containers.UI.GridContainerDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PlacementEditor" TargetType="TextBox">
            <Setter Property="Width" Value="48" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock Text="Rows" />
            <TextBox x:Name="RowsEditor" Text="{Binding RowCount, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Margin="0,0,0,2" />
            <TextBlock Foreground="Firebrick" TextWrapping="Wrap" Text="{Binding ElementName=RowsEditor, Path=(Validation.Errors)[0].ErrorContent}" />
            <TextBlock Text="Columns" Margin="0,6,0,0" />
            <TextBox x:Name="ColumnsEditor" Text="{Binding ColumnCount, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Margin="0,0,0,2" />
            <TextBlock Foreground="Firebrick" TextWrapping="Wrap" Text="{Binding ElementName=ColumnsEditor, Path=(Validation.Errors)[0].ErrorContent}" />
            <TextBlock Text="Width (0 = automatic)" Margin="0,6,0,0" />
            <TextBox x:Name="WidthEditor" Text="{Binding Width, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
            <TextBlock Foreground="Firebrick" TextWrapping="Wrap" Text="{Binding ElementName=WidthEditor, Path=(Validation.Errors)[0].ErrorContent}" />
            <TextBlock Text="Height (0 = automatic)" Margin="0,6,0,0" />
            <TextBox x:Name="HeightEditor" Text="{Binding Height, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
            <TextBlock Foreground="Firebrick" TextWrapping="Wrap" Text="{Binding ElementName=HeightEditor, Path=(Validation.Errors)[0].ErrorContent}" />
            <CheckBox x:Name="EqualColumnWidthsEditor" Content="Equal column widths" IsChecked="{Binding EqualColumnWidths, Mode=TwoWay}" Margin="0,8,0,0" />
            <CheckBox x:Name="EqualRowHeightsEditor" Content="Equal row heights" IsChecked="{Binding EqualRowHeights, Mode=TwoWay}" Margin="0,8,0,0" />
            <CheckBox x:Name="ShowGridEditor" Content="Show grid" IsChecked="{Binding ShowGrid, Mode=TwoWay}" Margin="0,8,0,0" />
            <CheckBox x:Name="ShowGrabberEditor" Content="Show grabber" IsChecked="{Binding ShowGrabber, Mode=TwoWay}" Margin="0,8,0,0" />

            <TextBlock Text="Controls (rows and columns start at 0)" Margin="0,12,0,4" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock Text="{Binding Node.Name}" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <TextBlock Text="Row" />
                                    <TextBox x:Name="RowEditor" Style="{StaticResource PlacementEditor}" Text="{Binding Row, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Column" />
                                    <TextBox x:Name="ColumnEditor" Style="{StaticResource PlacementEditor}" Text="{Binding Column, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Row span" />
                                    <TextBox x:Name="RowSpanEditor" Style="{StaticResource PlacementEditor}" Text="{Binding RowSpan, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Column span" />
                                    <TextBox x:Name="ColumnSpanEditor" Style="{StaticResource PlacementEditor}" Text="{Binding ColumnSpan, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Foreground="Firebrick" TextWrapping="Wrap">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}{1}{2}{3}">
                                        <Binding ElementName="RowEditor" Path="(Validation.Errors)[0].ErrorContent" TargetNullValue="" FallbackValue="" />
                                        <Binding ElementName="ColumnEditor" Path="(Validation.Errors)[0].ErrorContent" TargetNullValue="" FallbackValue="" />
                                        <Binding ElementName="RowSpanEditor" Path="(Validation.Errors)[0].ErrorContent" TargetNullValue="" FallbackValue="" />
                                        <Binding ElementName="ColumnSpanEditor" Path="(Validation.Errors)[0].ErrorContent" TargetNullValue="" FallbackValue="" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
